# runtime data — persisted on the host, not in the repo.
# The DB is rebuilt on deploy via `prisma migrate deploy` + prisma/seed.ts,
# so SQLite files in any location (./data, prisma/data) stay out of git.
*.db
*.db-journal
uploads/*
!uploads/.gitkeep

# build artifacts
*.tsbuildinfo

# README is instructor/scenario notes — never ship to exercise targets
README.md
